# Copy to .env and fill in. Never commit .env.

# SQLite file path (persists across restarts). Any SQLAlchemy URL works.
DATABASE_URL=sqlite:///./data/patients.db
# Insert two fictional demo patients when the table is empty.
SEED_DEMO_DATA=true
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Public https origin Vapi reaches this server on (your ngrok static domain), no trailing slash.
PUBLIC_BASE_URL=https://your-name.ngrok-free.dev

# Long random string. On the Vapi phone number, add the header X-Vapi-Secret with this value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_SECRET=
# Open-weights model Vapi runs on Groq.
VAPI_LLM_MODEL=openai/gpt-oss-120b
# gpt-oss is tuned for 1.0; lower values caused repetition loops in testing.
LLM_TEMPERATURE=1.0
# "en" is most accurate for English callers; "multi" adds Spanish recognition.
VAPI_TRANSCRIBER_LANGUAGE=en
# Minimum seconds between "is everything correct?" and an accepted save.
CONFIRM_MIN_SECS=3.0

# Only for scripts/chat_cli.py (test the agent by text against Groq directly).
GROQ_API_KEY=

# Kokoro-82M (Apache-2.0) runs locally. Download the two files into models/ (see README).
KOKORO_MODEL_PATH=models/kokoro-v1.0.int8.onnx
KOKORO_VOICES_PATH=models/voices-v1.0.bin
KOKORO_VOICE_EN=af_heart
KOKORO_VOICE_ES=ef_dora
# Load Kokoro at startup so the first call doesn't wait for it.
TTS_WARM_UP=true
